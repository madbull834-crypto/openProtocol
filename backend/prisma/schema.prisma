generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Participant {
  address     String   @id @db.VarChar(42)
  sponsor     String?  @db.VarChar(42)
  memberId    BigInt   @unique
  directCount Int      @default(0)
  joinedAt    DateTime
  blockNumber BigInt
  txHash      String   @db.VarChar(66)
  logIndex    Int
  createdAt   DateTime @default(now())

  @@unique([txHash, logIndex])
  @@index([sponsor])
}

model Allocation {
  id               BigInt   @id @default(autoincrement())
  account          String   @db.VarChar(42)
  workingAmount    Decimal  @db.Decimal(78, 0)
  nonWorkingAmount Decimal  @db.Decimal(78, 0)
  clubAmount       Decimal  @db.Decimal(78, 0)
  blockNumber      BigInt
  txHash           String   @db.VarChar(66)
  logIndex         Int
  createdAt        DateTime @default(now())

  @@unique([txHash, logIndex])
  @@index([account])
}

model BlockCheckpoint {
  blockNumber BigInt @id
  blockHash   String @db.VarChar(66)
  createdAt   DateTime @default(now())
}

model RewardCredit {
  id          BigInt   @id @default(autoincrement())
  account     String   @db.VarChar(42)
  amount      Decimal  @db.Decimal(78, 0)
  reason      String   @db.VarChar(66)
  blockNumber BigInt
  txHash      String   @db.VarChar(66)
  logIndex    Int
  createdAt   DateTime @default(now())

  @@unique([txHash, logIndex])
  @@index([account, reason])
}

model Claim {
  id          BigInt   @id @default(autoincrement())
  account     String   @db.VarChar(42)
  gross       Decimal  @db.Decimal(78, 0)
  net         Decimal  @db.Decimal(78, 0)
  royalty     Decimal  @db.Decimal(78, 0)
  development Decimal  @db.Decimal(78, 0)
  blockNumber BigInt
  txHash      String   @db.VarChar(66)
  logIndex    Int
  createdAt   DateTime @default(now())

  @@unique([txHash, logIndex])
  @@index([account])
}

/// One `PoolIncomeQueued` event: `account` reached `level` in `pool` (1 Single-Leg, 2 Working, 3 Non-Working)
/// and `amount` was queued (Single-Leg: own + 2 × upline; Working/Non-Working: the level's distributable).
model PoolQueue {
  id          BigInt   @id @default(autoincrement())
  account     String   @db.VarChar(42)
  pool        Int
  level       Int
  amount      Decimal  @db.Decimal(78, 0)
  blockNumber BigInt
  txHash      String   @db.VarChar(66)
  logIndex    Int
  createdAt   DateTime @default(now())

  @@unique([txHash, logIndex])
  @@index([account])
}
